# Heureum — Environment Configuration
# Copy this file to .env and edit before running docker compose.
#
#   cp .env.example .env
#   docker compose -f deploy/docker/docker-compose.yml up -d --build

# --- Required ---
APP_SECRET=change-me                     # JWT signing secret + git token encryption key (required; >= 32 chars when APP_ENV=production, else startup error)
DB_DSN=postgres://user:pass@localhost:5432/heureum?sslmode=disable  # required

# --- Optional (with defaults) ---
APP_PORT=8080
APP_ENV=development
APP_BASE_URL=http://localhost:8080
DB_DRIVER=postgres                       # postgres | mysql | sqlite
REDIS_URL=redis://localhost:6379/0
APP_UPLOADS_DIR=./data/uploads           # local disk path for issue attachments
# Public registration policy: open | closed. Unset = closed when APP_ENV=production, open otherwise;
# any other value is a startup error. Whatever the policy, the first registration on an instance
# with no active admin is accepted and becomes global admin (bootstrap).
APP_SIGNUP=
API_PORT=8080                            # compose-only: host port published for the api service
# Outgoing webhooks refuse private/loopback/link-local targets (SSRF). Comma-separated hosts,
# IPs or CIDRs to allow anyway (self-hosted targets), e.g. forgejo.home.arpa,192.168.1.0/24
# A hostname entry is trusted wherever it resolves (loopback/link-local included); an IP/CIDR
# entry lifts the restriction only for that address range.
APP_WEBHOOK_ALLOW_PRIVATE_HOSTS=
# Reverse proxies (IPs/CIDRs, comma-separated) whose X-Forwarded-For is trusted when resolving
# the client IP for auth rate limiting; from any other peer the header is ignored (RemoteAddr is
# the client). Set it to your nginx/ingress address(es) when the API runs behind a proxy,
# e.g. 127.0.0.1,10.42.0.0/16. A malformed entry is a startup error.
APP_TRUSTED_PROXIES=

# --- SMTP (notification email; read by the worker) ---
# Set these to enable notification emails. Leave SMTP_HOST empty to disable email
# (the worker then only delivers in-app notifications). SMTP_USER/PASS are optional
# (omit for an unauthenticated relay); SMTP_PORT defaults to 587.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=heureum@example.com
# SMTP_PASS=change-me
# SMTP_FROM=heureum@example.com

# --- Planned (NOT yet read by the app) ---
# OAuth (Forgejo/GitLab/GitHub) is configured per-project in the DB, not via env.
# Object storage (S3) for attachments/avatars is planned; today they use local disk.
